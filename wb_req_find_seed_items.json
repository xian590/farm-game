{"action":"evaluate","args":{"code":"(()=>{const items=document.querySelectorAll('.seed-item, .shop-item');return JSON.stringify({count:items.length,texts:Array.from(items).slice(0,6).map(item=>{const name=item.querySelector('.seed-name, .item-name, h4, .name');const price=item.querySelector('.seed-price, .item-price, .price');const btn=item.querySelector('button');return (name?name.textContent.trim():'')+'|'+(price?price.textContent.trim():'')+'|BTN:'+(btn?btn.textContent.trim():'')})})})()"},"session":"farm-game"}
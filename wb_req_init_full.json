{"action":"evaluate","args":{"code":"(()=>{try{initGame('normal');const story=document.getElementById('story-container');if(story)story.style.display='none';const select=document.getElementById('select-container');if(select)select.style.display='none';if(typeof updateUI==='function')updateUI();return JSON.stringify({ok:true,mode:game.mode,day:game.day,money:game.money,stamina:game.stamina,maxStamina:game.maxStamina,health:game.health,maxHealth:game.maxHealth,season:game.season,fieldsCount:game.fields?game.fields.length:0,house:game.house,reputation:game.reputation,mood:game.mood,disasterRate:game.disasterRate})}catch(e){return JSON.stringify({ok:false,error:e.message})}})()"},"session":"farm-game"}
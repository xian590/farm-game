{"action":"evaluate","args":{"code":"(()=>{try{const select=document.getElementById('select-container');const story=document.getElementById('story-container');const main=document.getElementById('main-container');const gameContainer=document.getElementById('game-container');return JSON.stringify({selectDisplay:select?select.style.display:null,storyDisplay:story?story.style.display:null,mainExists:!!main,gameContainerExists:!!gameContainer,bodyChildren:document.body.children.length,bodyChildTags:Array.from(document.body.children).slice(0,5).map(c=>c.tagName+'#'+(c.id||c.className).slice(0,30)})}catch(e){return e.message;}})()"},"session":"farm-game"}
{"action":"evaluate","args":{"code":"(()=>{try{for(let i=localStorage.length-1;i>=0;i--){localStorage.removeItem(localStorage.key(i));}initGame('normal');clearInterval(window.gameTickInterval);clearInterval(window.autoPlayInterval);if(typeof gameSpeed!=='undefined')gameSpeed=0;return JSON.stringify({ok:true,day:game.day,money:game.money,stamina:game.stamina,health:game.health,season:game.season,fieldsCount:game.fields.length})}catch(e){return JSON.stringify({ok:false,error:e.message})}})()"},"session":"farm-game"}
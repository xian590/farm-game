{"action":"evaluate","args":{"code":"(()=>{try{const s=localStorage.getItem('farm_game_save_v1');const d=JSON.parse(s);return JSON.stringify({ok:true,day:d.day,season:d.season,time:d.time,money:d.money,stamina:d.stamina,maxStamina:d.maxStamina,health:d.health,maxHealth:d.maxHealth,fieldsCount:d.fields?d.fields.length:0,fields:d.fields?d.fields.map(f=>({stage:f.stage,crop:f.crop,progress:f.progress||0})):null,eventsToday:d.eventsToday||0,eventHistoryCount:d.eventHistory?d.eventHistory.length:0,skills:d.skills,npcs:d.npcs,reputation:d.reputation,mood:d.mood,weather:d.weather,mode:d.mode,disasterRate:d.disasterRate,stats:d.stats,items:d.items,seeds:d.seeds,buildings:d.buildings,house:d.house,quests:d.quests?Object.keys(d.quests).filter(k=>d.quests[k]).length:0,petCount:d.pets?Object.keys(d.pets).length:0,workers:d.hiredWorkers?d.hiredWorkers.length:0,composting:d.composting?d.composting.level:0,fishPond:d.fishPond?d.fishPond.built:false,currentEvent:d.currentEvent?d.currentEvent.id:null})}catch(e){return JSON.stringify({ok:false,error:e.message})}})()"},"session":"farm-game"}
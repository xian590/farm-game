{"action":"evaluate","args":{"code":"(()=>{try{const m=document.querySelector('.modal-overlay');if(!m)return 'NO_MODAL';const btns=m.querySelectorAll('button');const info={modalHTML:m.innerHTML.slice(0,500),btnCount:btns.length,btnTexts:Array.from(btns).map(b=>b.textContent.trim()),btnClasses:Array.from(btns).map(b=>b.className)};return JSON.stringify(info);}catch(e){return e.message;}})()"},"session":"farm-game"}